<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PKHeXHostDirectory Condition="'$(PKHeXHostDirectory)' == ''">$(MSBuildProjectDirectory)\..\..\dependencies\host</PKHeXHostDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\LanguageDexGenerator\LanguageDexGenerator.csproj" />
    <Reference Include="PKHeX.Core"><HintPath>..\..\dependencies\PKHeX.Core.dll</HintPath></Reference>
    <Reference Include="PKHeX"><HintPath>$(PKHeXHostDirectory)\PKHeX.dll</HintPath></Reference>
    <Reference Include="PKHeX.Drawing"><HintPath>$(PKHeXHostDirectory)\PKHeX.Drawing.dll</HintPath></Reference>
    <Reference Include="PKHeX.Drawing.Misc"><HintPath>$(PKHeXHostDirectory)\PKHeX.Drawing.Misc.dll</HintPath></Reference>
    <Reference Include="PKHeX.Drawing.PokeSprite"><HintPath>$(PKHeXHostDirectory)\PKHeX.Drawing.PokeSprite.dll</HintPath></Reference>
    <Reference Include="QRCoder"><HintPath>$(PKHeXHostDirectory)\QRCoder.dll</HintPath></Reference>
  </ItemGroup>
</Project>
