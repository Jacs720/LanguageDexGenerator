<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LanguageDexGenerator</AssemblyName>
    <RootNamespace>LanguageDexGenerator</RootNamespace>
    <OutputType>Library</OutputType>
    <Version>1.0.2</Version>
    <!-- Point these to DLLs built from MATCHING commits of PKHeX + PKHeX-Plugins. -->
    <PKHeXCorePath Condition="'$(PKHeXCorePath)' == ''">$(MSBuildProjectDirectory)\..\dependencies\PKHeX.Core.dll</PKHeXCorePath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PKHeX.Core"><HintPath>$(PKHeXCorePath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
